      "source": [
        "# 作業名稱：Python 聚餐費用試算器\n",
        "# 姓名：廖音淇\n",
        "# 學號：請填入你的學號\n",
        "\n",
        "# 第一組原始資料\n",
        "event_name = \"  WEEKEND DINNER  \"\n",
        "meal_amount = \" NT$1,200 \"\n",
        "people = \"4\"\n",
        "service_rate = 0.10\n",
        "discount = 100\n",
        "budget_per_person = 300\n",
        "\n",
        "# 1. 整理聚餐名稱（去除頭尾空白並轉小寫）\n",
        "cleaned_name = event_name.strip().lower()\n",
        "\n",
        "# 2. 整理餐費與人數並轉換型別\n",
        "clean_amount_str = meal_amount.replace(\"NT$\", \"\").replace(\",\", \"\").strip()\n",
        "meal_cost = float(clean_amount_str)\n",
        "num_people = int(people)\n",
        "\n",
        "# 3. 分步計算費用\n",
        "service_fee = meal_cost * service_rate\n",
        "total_amount = meal_cost + service_fee - discount\n",
        "per_person_cost = total_amount / num_people\n",
        "\n",
        "# 4. 判斷是否超過預算\n",
        "is_over_budget = per_person_cost > budget_per_person\n",
        "\n",
        "# 5. 輸出費用摘要\n",
        "print(f\"聚餐名稱：{cleaned_name}\")\n",
        "print(f\"原始餐費：{meal_cost:.2f} 元\")\n",
        "print(f\"服務費：{service_fee:.2f} 元\")\n",
        "print(f\"折價券：{discount:.2f} 元\")\n",
        "print(f\"應付總額：{total_amount:.2f} 元\")\n",
        "print(f\"分攤人數：{num_people} 人\")\n",
        "print(f\"每人費用：{per_person_cost:.2f} 元\")\n",
        "print(f\"每人預算：{budget_per_person:.2f} 元\")\n",
        "print(f\"是否超過預算：{is_over_budget}\")"
      ]
